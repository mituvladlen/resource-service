# Copy to .env and adjust. NEVER commit .env.
PORT=3001

# memory = in-memory store (no DB needed), postgres = PostgreSQL (DATABASE_URL)
STORAGE=postgres

# Used by docker-compose.yml to create the database container
POSTGRES_USER=resource_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=resource_db
POSTGRES_PORT=5433
DATABASE_URL=postgres://resource_user:change_me@localhost:5433/resource_db

# mock = built-in fake Player/World services (Lab 1), http = real services (Lab 2)
PLAYER_CLIENT=mock
WORLD_CLIENT=mock
PLAYER_SERVICE_URL=http://localhost:3000
WORLD_SERVICE_URL=http://localhost:3003
# Comma-separated player ids the Player mock knows about
MOCK_PLAYERS=player-1,player-2,player-3,player-4
