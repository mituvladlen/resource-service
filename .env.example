# Copy to .env and adjust. NEVER commit .env.
PORT=3001

# memory = in-memory store (no DB needed), postgres = PostgreSQL (DATABASE_URL)
STORAGE=postgres

# Used by docker-compose.yml to create the database container
POSTGRES_USER=resource_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=resource_db
POSTGRES_PORT=5433
DATABASE_URL=postgres://resource_user:change_me@localhost:5433/resource_db

# mock = built-in fake Player/World services (Lab 1), http = real services through the Gateway (Lab 2)
PLAYER_CLIENT=mock
WORLD_CLIENT=mock
# Every outgoing call goes through the Gateway, never straight to another container
PLAYER_SERVICE_URL=http://gateway:8080/player
WORLD_SERVICE_URL=http://gateway:8080/world
# Service JWT sent as "Authorization: Bearer" on calls through the Gateway (get it privately, never commit it)
SERVICE_TOKEN=
# Timeout for calls to other services (ms)
OUTGOING_TIMEOUT_MS=3000

# Per-request timeout (408) and in-flight request limit (429). Set low for the demo, e.g. 100 and 2.
REQUEST_TIMEOUT_MS=5000
MAX_CONCURRENT_REQUESTS=100
# Demo only: artificial delay per request (ms). With 300 and the values above set to 100 and 2, 408 and 429 show up reliably. Keep 0 otherwise.
SIMULATED_LATENCY_MS=0
# Comma-separated player ids the Player mock knows about
MOCK_PLAYERS=player-1,player-2,player-3,player-4
